# ==============================================================================
# FLUENCYAIPOWER — ENVIRONMENT VARIABLES FOR PRODUCTION & VERCEL
# ==============================================================================

# 1. Google Gemini Official API Key (CRITICAL: Server-side only, NEVER use VITE_ prefix)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Host Application URL
APP_URL="MY_APP_URL"

# 3. Firebase Configuration for Vercel / External Hosting
# In AI Studio, firebase-applet-config.json is used automatically.
# On Vercel, set these in Project Settings -> Environment Variables:
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_DATABASE_ID="ai-studio-fluencypathai-0c65630b-de94-4354-b133-2133611ff031"

# 4. Optional Server-side token verification overrides
FIREBASE_API_KEY="your-firebase-api-key"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_DATABASE_ID="ai-studio-fluencypathai-0c65630b-de94-4354-b133-2133611ff031"
